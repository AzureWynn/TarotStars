# Telegram Bot
# 请填入真实值；不要提交填写后的 .env
BOT_TOKEN=your_bot_token
TELEGRAM_BOT_SECRET_TOKEN=your_telegram_bot_secret_token

# MongoDB (docker-compose 内使用服务名 mongo)
MONGODB_URI=mongodb://mongo:27017/tarot-stars
MONGODB_DB_NAME=tarot-stars

# Server
PORT=3001
NODE_ENV=production
SKIP_TELEGRAM_AUTH=false
MINI_APP_URL=https://your-mini-app-domain.com

# Web build
# 必须是 Telegram WebView 能访问的公网 HTTPS API 地址
REACT_APP_API_BASE_URL=https://your-api-domain.com/api/v2/tarot

# Security
# 请生成新的随机值，不要使用示例值
JWT_SECRET=replace_with_random_secret
API_SECRET=replace_with_random_secret

# 开发代理（仅本地调试需要，Docker 生产环境不要设置）
# SOCKS_PROXY=socks5://127.0.0.1:7890
