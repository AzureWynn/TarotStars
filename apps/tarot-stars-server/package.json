{
  "name": "tarot-stars-server",
  "version": "1.0.0",
  "description": "Tarot Stars Server with Telegram Bot and Mini App",
  "scripts": {
    "dev": "export DEBUG='grammy*' && nodemon src/runtime.local.ts",
    "build": "tsc",
    "start": "node dist/runtime.local.js",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "migrate:rider-waite": "ts-node src/scripts/migrate-rider-waite.ts",
    "import:tarot-cards": "ts-node src/scripts/import-tarot-cards.ts"
  },
  "keywords": [
    "telegram",
    "bot",
    "tarot",
    "mini-app",
    "mongodb",
    "ddd"
  ],
  "author": "Tarot Stars Team",
  "license": "MIT",
  "dependencies": {
    "@grammyjs/conversations": "^1.2.0",
    "@grammyjs/menu": "^1.2.1",
    "@grammyjs/types": "3.18.0",
    "axios": "^1.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.18.2",
    "grammy": "^1.34.0",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "mongodb": "^6.3.0",
    "socks-proxy-agent": "^8.0.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.9.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}